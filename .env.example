# Example .env file for Tennis Rules RAG
# Copy this file to .env and fill in real values (do NOT commit the .env file)

# Supabase project URL - found in Supabase dashboard > Settings > API
SUPABASE_URL=

# Supabase service role key (secret) - found in Supabase dashboard > Settings > API
# WARNING: Never expose this key in client-side code
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key - obtained from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Password for the admin dashboard
# Must match the ADMIN_PASSWORD secret set in Supabase Edge Functions (tennis-etl)
ADMIN_PASSWORD=

# Allowed CORS origin for the tennis-rag-query Edge Function
# e.g., https://your-site.netlify.app  (use * for development only)
ALLOWED_ORIGIN=
